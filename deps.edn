{:paths ["src"]

 ;; The server binds BSD sockets (socket/bind/listen/accept/recv/send) directly
 ;; over jolt.ffi. Those live in the C standard library, reached through the
 ;; running process's own symbols — declared here as :process so jolt loads them
 ;; before the namespace is required.
 :jolt/native [{:name "libc (POSIX sockets)" :process true}]

 ;; jolt-crypto (AES/HMAC/SecureRandom over OpenSSL) rides along so an app that
 ;; wraps its handler with ring-defaults — whose session + CSRF middleware needs
 ;; javax.crypto — just has to (require 'jolt.crypto); no separate dep. It's not
 ;; required here, so a plain adapter server doesn't pull in OpenSSL.
 :deps {jolt-lang/jolt-crypto {:git/url "https://github.com/jolt-lang/jolt-crypto"
                               :git/sha "0adae49db6064180374ffdcfc72b5b9ac01888cd"}}

 ;; The test drives the server with the jolt-lang/http-client library (jolt no
 ;; longer ships a built-in HTTP client). v0.0.4 or newer matters here: earlier
 ;; versions replace java.io.ByteArrayInputStream process-wide with a shim, so
 ;; the SUITE's request bodies (not an app's — this dep is test-only) were a
 ;; stream ~1300x slower to drain and without .readAllBytes.
  :aliases {:test {:extra-paths ["test"]
                   :extra-deps {jolt-lang/http-client
                                {:git/url "https://github.com/jolt-lang/http-client"
                                :git/tag "v0.0.5"
                                :git/sha "04825632ed96a77a1c6ba1921c0a31280a3daade"}}
                   :main-opts ["-m" "ring-chez.adapter-test"]}
           :bench {:extra-paths ["test"]
                   :main-opts ["-m" "ring-chez.bench"]}}

 :tasks {test "jolt -M:test"}}
